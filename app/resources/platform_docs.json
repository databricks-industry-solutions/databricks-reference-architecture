"ingestion": [
{
"n": "Lakeflow Connect (managed connectors)",
"p": "ingestion/lakeflow-connect/",
"when": "Fully-managed, UC-governed ingestion from SaaS apps and databases with minimal config."
},
{
"n": "Auto Loader",
"p": "ingestion/cloud-object-storage/auto-loader/",
"when": "Incrementally ingest files as they land in cloud object storage (cloudFiles)."
},
{
"n": "Lakeflow Declarative Pipelines",
"p": "ldp/",
"when": "Declarative ETL for streaming tables, materialized views, CDC, and data-quality expectations."
},
{
"n": "Zerobus ingest",
"p": "ingestion/zerobus-ingest",
"when": "High-throughput direct write of event/telemetry data straight into Delta via an API, no message bus."
},
{
"n": "Lakehouse Federation",
"p": "query-federation/",
"when": "Query external databases/warehouses (e.g. Snowflake, Postgres) in place without moving data."
},
{
"n": "Delta Sharing",
"p": "data-sharing/",
"when": "Ingest/share live data across orgs and platforms via the open sharing protocol."
},
{
"n": "Databricks Marketplace",
"p": "marketplace/",
"when": "Acquire third-party datasets and data products as ready-to-use shares."
}
